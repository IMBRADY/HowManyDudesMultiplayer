; HowManyDudesMultiplayer session config.
;
; You do not need this file. The mod writes its own
; HowManyDudesMultiplayer.ini next to the DLL on the first run, with these
; same defaults and comments, and never overwrites it afterwards. This copy
; is here for reference.
;
; If you do want to use it: putting it beside the DLL under either name works.
; The mod reads HowManyDudesMultiplayer.ini if it exists, otherwise falls back
; to this .example file, so copying it without renaming still applies.

; Where the JOINING player looks for the host. Ignored by the host.
;   auto             - find the host automatically on the local network.
;                      No addresses to exchange. (default)
;   <ip or hostname> - dial that address instead. Needed over the internet,
;                      or if discovery is blocked on your network.
peer_address = auto

; TCP port. Both players must agree. The host must have it reachable.
; LAN discovery uses the next port up (default 47802).
port = 47801

; Shared passphrase. Both players must set the SAME value or the connection
; is refused. Leave empty on a trusted LAN. Set it to anything you both agree
; on before forwarding the port to the internet, otherwise any host that can
; reach the port may join.
;
; Note: traffic is not encrypted. This controls who may connect; it does not
; hide what is sent.
session_key =

; Answer and send local-network discovery probes. Turn off to make the mod
; address-only.
enable_discovery = true

; Open a session automatically at load instead of waiting for F9/F10.
; Set at most one of these, on the matching machine.
auto_host = false
auto_join = false

; How many rounds between duels.
;
; Every this many rounds the boss fight is replaced by a fight against your
; opponent's army. 20 is the length of an act, so by default the duel lands
; exactly where the boss would have been.
;
; The two runs are not step-locked, so whoever reaches the duel round first
; waits: the arena is held empty behind a "waiting for..." banner until the
; other player gets there. If they never do, the duel is called off after five
; minutes and the round is played normally.
;
; Both players should set the same value.
duel_interval = 20

; Pressing "start run" also starts your opponent's run, so you both drop into
; a run together instead of coordinating it out loud. Either player starting
; pulls the other in; whoever is already in a run is left alone.
;
; Turn off to start runs independently.
sync_run_start = true

; Show the mod's messages on screen, using the game's own message stream:
; connecting, duels starting, lives lost, the final result.
;
; Turn off if it misbehaves. Everything the mod says still goes to aurie.log
; either way, and F8 still prints a status line.
on_screen_messages = true

; DIAGNOSTIC. Leave this off unless you are deliberately measuring with it.
;
; The F5 injection probe creates one enemy using the game's own routines and
; then destroys it, so pressing F5 cannot change the difficulty of your run.
;
; That cleanup also hides the one thing the probe most needs to know. Its
; success signal is the enemy counter going up, and a counter is not the same
; question as "will the round refuse to end while this thing is alive" - which
; is what a duel actually depends on. With this on, the probe leaves the enemy
; standing so that question can be answered by playing the round out.
;
; The cost is a real extra enemy in that run. Turn it back off afterwards.
injection_persist = false
